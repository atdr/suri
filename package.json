{
  "name": "atdr.eu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Short links for atdr.eu, built with Suri",
  "homepage": "https://github.com/atdr/atdr.eu#readme",
  "license": "MIT",
  "repository": "atdr/atdr.eu",
  "scripts": {
    "build": "suri",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "validate": "node scripts/validate-links.mjs",
    "check": "npm run lint && npm run validate && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@surishortlink/suri": "^1",
    "prettier": "^3"
  },
  "engines": {
    "node": ">=20"
  }
}
